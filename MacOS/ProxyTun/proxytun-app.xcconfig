// Configuration settings file format documentation can be found at:
// https://developer.apple.com/documentation/xcode/adding-a-build-configuration-file-to-your-project

// MARK: - Team Configuration
DEVELOPMENT_TEAM = L******* // update it

// MARK: - Main App Signing (ProxyTun)
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Developer ID Application
CODE_SIGN_ENTITLEMENTS = ProxyTun/ProxyTunRelease.entitlements
PRODUCT_BUNDLE_IDENTIFIER = com.proxytun.ProxyTun
PRODUCT_MODULE_NAME = ProxyTun
PRODUCT_NAME = ProxyTun
PROVISIONING_PROFILE_SPECIFIER = ProxyTun Prod

// MARK: - Additional Signing Settings
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO
ENABLE_HARDENED_RUNTIME = YES

// MARK: - Architecture (Universal Binary: Intel + Apple Silicon)
ARCHS = arm64 x86_64
ONLY_ACTIVE_ARCH = NO
